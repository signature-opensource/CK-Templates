<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>CK.Templates</PackageId>
    <Title>CK Templates</Title>
    <Authors>Signature Code</Authors>
    <Description>Templates to use when creating a CK package.</Description>
    <PackageTags>dotnet-new;templates;signature-code</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**\*" />
  </ItemGroup>
  <!-- The templates/ folder is generated by the build of TemplateBuilder: this reference only orders the build. -->
  <ItemGroup>
    <ProjectReference Include="..\TemplateBuilder\TemplateBuilder.csproj" ReferenceOutputAssembly="false" PrivateAssets="All" />
  </ItemGroup>
  <!-- The templates are collected when packing (not at evaluation time), since they may be generated after
       this project has been evaluated. -->
  <Target Name="CollectGeneratedTemplates" BeforeTargets="_GetPackageFiles">
    <Error Condition=" !Exists('templates') " Text="Missing generated 'templates' folder: TemplateBuilder must be built first." />
    <ItemGroup>
      <Content Remove="templates\**\*" />
      <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.idea\**;templates\**\.vs\**;templates\**\Tests\**\Logs\**" />
    </ItemGroup>
  </Target>
</Project>
